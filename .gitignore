# ============================================
# Time Gambler - .gitignore
# ============================================

# ============ Environment Variables (敏感!) ============
.env
.env.*
!.env.example
app/.env
ai_engine/.env

# ============ Node.js / Expo ============
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# ============ Foundry / Solidity ============
contracts/cache/
contracts/out/
contracts/broadcast/
!contracts/broadcast/.gitkeep

# ============ macOS ============
.DS_Store
*.pem
.AppleDouble
.LSOverride

# ============ Logs ============
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ IDE / Editor ============
.vscode/
.idea/
*.swp
*.swo
*~

# ============ Build Artifacts ============
*.local
coverage/
.nyc_output/

# ============ Docs (私有文档) ============
DOCS/

# ============ Misc ============
.cache/
tmp/
temp/
