###############################################################################
#                    🚀 FocusFlow AI Engine 环境配置模板
###############################################################################
#
# 【如何使用此模板】
#
# 1️⃣ 复制此文件并重命名:
#      cp .env.example .env
#
# 2️⃣ 选择你的 LLM 提供商:
#      本项目基于 SpoonOS SDK，支持 OpenAI-compatible 和 Anthropic-compatible 两种协议。
#      中国大模型普遍支持其中一种或两种协议。
#
# 3️⃣ 根据你选择的模型，填写 LLM_PROVIDER / LLM_MODEL / BASE_URL / API_KEY 四个变量。
#      参考下方【中国模型配置参考】章节。
#
# 4️⃣ 启动 AI 引擎:
#      cd ai_engine
#      python api.py
#
###############################################################################
#                    📖 中国模型配置参考 (Chinese LLM Support)
###############################################################################
#
# ┌─────────────┬───────────────────────────────────────────────────────────────────────────────┐
# │  厂商        │  配置方式                                                                     │
# ├─────────────┼───────────────────────────────────────────────────────────────────────────────┤
# │  智谱 GLM    │  BASE_URL=https://open.bigmodel.cn/api/anthropic/v1                          │
# │             │  LLM_PROVIDER=anthropic                                                       │
# │             │  LLM_MODEL=glm-4-flash (便宜) 或 glm-4.7 (最强)                                 │
# │             │  ANTHROPIC_API_KEY=<你的智谱API Key>                                          │
# │             │  获取 Key: https://bigmodel.cn/usercenter/apikeys                              │
# ├─────────────┼───────────────────────────────────────────────────────────────────────────────┤
# │  DeepSeek   │  BASE_URL=https://api.deepseek.com/v1                                         │
# │             │  LLM_PROVIDER=openai  (DeepSeek 使用 OpenAI 兼容协议)                          │
# │             │  LLM_MODEL=deepseek-chat (便宜) 或 deepseek-reasoner (R1推理模型)               │
# │             │  OPENAI_API_KEY=<你的DeepSeek API Key>                                        │
# │             │  获取 Key: https://platform.deepseek.com/api_keys                              │
# ├─────────────┼───────────────────────────────────────────────────────────────────────────────┤
# │  MiniMax    │  BASE_URL=https://api.minimax.chat/v1                                         │
# │             │  LLM_PROVIDER=openai  (MiniMax 使用 OpenAI 兼容协议)                           │
# │             │  LLM_MODEL=abab6.5s-chat (便宜) 或 abab7-chat (最强)                           │
# │             │  OPENAI_API_KEY=<你的MiniMax API Key>                                         │
# │             │  获取 Key: https://www.minimax.io/platform/user-center/basic-info              │
# ├─────────────┼───────────────────────────────────────────────────────────────────────────────┤
# │  豆包/火山  │  BASE_URL=https://ark.cn-beijing.volces.com/api/v3                            │
# │             │  LLM_PROVIDER=openai                                                          │
# │             │  LLM_MODEL=<你的推理端点ID, 如 ep-xxx-xxx>                                     │
# │             │  OPENAI_API_KEY=<你的火山引擎 API Key>                                         │
# │             │  获取 Key: https://console.volcengine.com/ark                                  │
# ├─────────────┼───────────────────────────────────────────────────────────────────────────────┤
# │  硅基流动   │  BASE_URL=https://api.siliconflow.cn/v1                                       │
# │  SiliconFlow│  LLM_PROVIDER=openai                                                          │
# │             │  LLM_MODEL=deepseek-ai/DeepSeek-V3 (推荐) 或其他托管模型                       │
# │             │  OPENAI_API_KEY=<你的SiliconFlow API Key>                                     │
# │             │  获取 Key: https://cloud.siliconflow.cn/account/ak                             │
# ├─────────────┼───────────────────────────────────────────────────────────────────────────────┤
# │  OpenAI     │  BASE_URL=https://api.openai.com/v1                                           │
# │             │  LLM_PROVIDER=openai                                                          │
# │             │  LLM_MODEL=gpt-4o (推荐) 或 gpt-4o-mini (便宜)                                 │
# │             │  OPENAI_API_KEY=sk-xxx (你的 OpenAI Key)                                      │
# └─────────────┴───────────────────────────────────────────────────────────────────────────────┘
#
# 【重要提示】
# - BASE_URL 必须包含 /v1 后缀 (对于 OpenAI 兼容协议) 或 /anthropic/v1 (对于智谱)
# - 只需要填写一个 API Key，根据 LLM_PROVIDER 选择 OPENAI_API_KEY 或 ANTHROPIC_API_KEY
# - 本项目推荐使用 glm-4-flash 或 deepseek-chat，性价比最高
#
###############################################################################

# ======= 核心 LLM 配置 (必填) =======
# 选择你的 LLM 提供商协议: "openai" 或 "anthropic"
LLM_PROVIDER=anthropic

# 你选择的模型名称 (参考上方表格)
LLM_MODEL=glm-4-flash

# LLM API 的 Base URL (参考上方表格，注意 /v1 后缀)
BASE_URL=https://open.bigmodel.cn/api/anthropic/v1

# ======= API Keys (只需填写一个) =======
# 如果 LLM_PROVIDER=openai, 填写此项:
OPENAI_API_KEY=your-openai-or-compatible-api-key

# 如果 LLM_PROVIDER=anthropic, 填写此项 (智谱使用此协议):
ANTHROPIC_API_KEY=your-anthropic-or-zhipu-api-key

# ======= 区块链配置 (本地开发) =======
# 本地 Anvil 节点 (默认端口 8545)
RPC_URL=http://localhost:8545

# 本地链 ID (Anvil 默认使用 31337，推荐改为 1337 以在 MetaMask 中显示 ETH)
CHAIN_ID=1337

# ======= Oracle 配置 (AI 验证上链) =======
# Anvil 默认账户 #0 的私钥 (仅限本地测试！生产环境请更换)
# ⚠️ 警告: 永远不要将真实私钥提交到 Git 仓库!
ORACLE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# FocusFlow 智能合约地址 (部署后更新)
# 运行 `forge script script/Deploy.s.sol --broadcast` 后获取新地址
CONTRACT_ADDRESS=0x0B306BF915C4d645ff596e518fAf3F9669b97016

# ======= 服务器配置 =======
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ======= 日志配置 =======
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ======= 数据库配置 (可选) =======
DATABASE_URL=sqlite:///./spoonai.db

# ======= 以下为高级配置，一般无需修改 =======

# Redis 配置 (如果需要缓存)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Telegram Bot 通知 (可选)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# GitHub Token (可选，用于仓库交互)
# GITHUB_TOKEN=your-github-token